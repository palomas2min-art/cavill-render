# Variáveis de ambiente necessárias para o deploy
# Copie este arquivo para .env e preencha com seus valores reais

# URL do banco PostgreSQL (Neon, Supabase, etc)
# Pegue em: https://console.neon.tech → seu projeto → Connection Details
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# ====================================================================
# API PRIMÁRIA: OpenRouter (Hermes 3 405B Free — sem censura, 131K contexto)
# Pegue sua chave em: https://openrouter.ai/keys (gratuita, sem cartão)
# Limites da tier free: 20 RPM / 200 requests por dia
# ====================================================================
OPENROUTER_API_KEY=sk-or-v1-sua_chave_aqui

# ====================================================================
# API FALLBACK: Z.ai (GLM-4.5-flash — usada se OpenRouter cair)
# Pegue em: https://z.ai/model-api
# ====================================================================
ZAI_API_KEY=sua_api_key_zai_aqui
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
ZAI_MODEL=glm-4.5-flash
